# Copy to .env. Never commit .env.

# Gate
# At least 32 bytes: python -c "import secrets; print(secrets.token_hex(32))"
SERVER_KEY=
# Shared with the webhook. At least 32 bytes, a different value from SERVER_KEY
INTERNAL_TOKEN=
DB_PATH=ordr.db
POLICY_PATH=policy.json
STORE_MCP_URL=http://127.0.0.1:8001/mcp

# Demo household, set up in advance. International format, digits only
PARENT_NUMBER=
KID_NUMBER=
SAFE_PHRASE=

# Channel: meta, twilio or telegram
CHANNEL=meta
WEBHOOK_SECRET=

# Language model and speech. Providers not chosen yet
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=
