# Copy to .env. Never commit .env.

# Gate
# At least 32 bytes: python -c "import secrets; print(secrets.token_hex(32))"
SERVER_KEY=
# Shared with the webhook. At least 32 bytes, a different value from SERVER_KEY
INTERNAL_TOKEN=
DB_PATH=ordr.db
POLICY_PATH=policy.json
STORE_MCP_URL=http://127.0.0.1:8001/mcp

# Demo household, made on the gate's first start. International format, digits only, different.
# If you change a number later, delete ordr.db (and ordr.db-wal, ordr.db-shm)
PARENT_NUMBER=
KID_NUMBER=
# Safe-phrase: at most 40 characters, so every card still fits
SAFE_PHRASE=
# Language of messages to the parent: kn or en. The kid always gets English
PARENT_LANG=kn

# ---- Bot (the webhook process). It never needs SERVER_KEY ----
# Same value as the gate's INTERNAL_TOKEN
# INTERNAL_TOKEN (above) and PARENT_NUMBER, KID_NUMBER, PARENT_LANG (above) are shared with the gate.
GATE_URL=http://127.0.0.1:8002
# meta (WhatsApp, main) or telegram (testing and backup)
CHANNEL=meta
BOT_DB_PATH=bot.db
# MCP calls (tool name and time only) are appended here as JSON lines, for the demo panel
MCP_LOG_PATH=mcp_calls.jsonl

# Telegram: make a bot with @BotFather. Then run `python -m ordr.bot --whoami` and message the
# bot from each phone: it prints the chat id to use as PARENT_NUMBER and KID_NUMBER
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (Meta). A system user token, not the 24 hour test token
META_TOKEN=
META_APP_SECRET=
META_PHONE_ID=
# Any string you choose. Paste the same one into Meta's webhook settings
META_VERIFY_TOKEN=

# Language model. Costs money: set a spending limit on the key. Never commit it
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Speech (not used yet)
STT_API_KEY=
TTS_API_KEY=
